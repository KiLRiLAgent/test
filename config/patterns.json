  "platform_specific": {
    "linkedin": {
      "tone": "professional but warm",
      "length": "medium to long",
      "emoji_usage": "moderate",
      "personal_experience": "highly valued",
      "examples": [
        "Согласен! У меня был похожий опыт когда работал в {company}. Главное что я понял - {insight}. Кстати, {question}?",
        "Отличный пост! По моему опыту, {personal_insight}. Попробуйте {suggestion} - мне очень помогло 💡"
      ]
    },
    "twitter": {
      "tone": "casual and witty",
      "length": "short to medium",
      "emoji_usage": "high",
      "personal_experience": "appreciated but brief",
      "examples": [
        "Согласен! У меня так же было 😅 Главное - {insight}",
        "Точно! Кстати, {question}? 🤔"
      ]
    },
    "facebook": {
      "tone": "friendly and conversational",
      "length": "medium",
      "emoji_usage": "high",
      "personal_experience": "highly valued",
      "examples": [
        "Ого! У меня была похожая ситуация... {story}. В итоге {outcome} 😊",
        "Спасибо за пост! Очень актуально. У меня {experience}. А как у вас? 🤗"
      ]
    }
  }
}
