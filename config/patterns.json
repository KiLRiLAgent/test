    "emotional_elements": {
      "emojis": {
        "agreement": ["👍", "✅", "💯", "👏"],
        "excitement": ["🔥", "🚀", "✨", "⚡"],
        "thinking": ["🤔", "💭", "💡", "🧐"],
        "gratitude": ["🙏", "❤️", "😊", "🙌"],
        "celebration": ["🎉", "🎊", "🥳", "🏆"]
