# API Keys
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# LinkedIn (если используете)
LINKEDIN_EMAIL=your_email
LINKEDIN_PASSWORD=your_password

# Twitter/X (если используете)
TWITTER_BEARER_TOKEN=your_token

# Настройки
MAX_POSTS=50
TOP_COMMENTS_PER_POST=3
MIN_ENGAGEMENT_SCORE=5

# Reddit API (получить на https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=Comment Analyzer Bot 1.0

# Reddit настройки парсинга
REDDIT_SUBREDDITS=ValueInvesting,DeepFuckingValue,StockMarket,wallstreetbets,WSBAfterHours
REDDIT_POSTS_LIMIT=10
DEEP_ANALYZE_COUNT=5
MIN_COMMENT_SCORE=10
